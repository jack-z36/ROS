<?xml version="1.0"?>
<package format="3">
  <name>baton_mini</name>
  <version>0.0.1</version>
  <description>Baton Mini SDK demo package with a ROS1/ROS2 compatible ros_interface wrapper.</description>

  <maintainer email="tl@gmail.com">tl</maintainer>
  <license>MIT</license>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>

  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend condition="$ROS_VERSION == 2">launch</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>

  <export>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
