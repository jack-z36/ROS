<?xml version="1.0"?>
<package format="3">
  <name>hwk_pressure_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 Python driver for HWK dexterous hand pressure sensors.</description>
  <maintainer email="maintainer@example.com">HWK Pressure Driver Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>hwk_pressure_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
