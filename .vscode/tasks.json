{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "colcon build: 当前包",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "${workspaceFolder}/.vscode/build_current_package.sh \"${file}\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "colcon build: 整个工作区",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd \"${workspaceFolder}\" && source /opt/ros/jazzy/setup.bash && colcon build --cmake-args -DUSE_ROS=ON"
            ],
            "problemMatcher": []
        }
    ]
}
