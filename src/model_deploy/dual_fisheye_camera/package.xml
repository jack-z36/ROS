<?xml version="1.0"?>
<package format="3">
  <name>dual_fisheye_camera</name>
  <version>0.1.0</version>
  <description>Dual fisheye camera node: publishes left/right fisheye Image streams via V4L2
    and a HardwareHealth status. Image acquisition reuses v4l2_camera_node; health is
    produced by a lightweight camera_health_node that subscribes to both image topics.</description>
  <maintainer email="maintainer@example.com">model_deploy Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>v4l-utils</exec_depend>
  <exec_depend>act_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
