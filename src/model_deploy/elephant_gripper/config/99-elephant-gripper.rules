# udev rules for the dual Elephant myGripper-F100 USB-485 adapters.
#
# The two adapters are very likely both CH340 (1a86:7523) and cannot be told
# apart by VID/PID, so we pin each side to a physical USB topology path
# (ID_PATH). Discover the real values on the target machine with, e.g.:
#
#   udevadm info -a -n /dev/ttyACM0 | grep -i ID_PATH
#   udevadm info -a -n /dev/ttyACM1 | grep -i ID_PATH
#
# then edit the ENV{ID_PATH}== values below to match the port each gripper is
# plugged into. Install and reload with:
#
#   sudo cp 99-elephant-gripper.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# This template is NOT applied automatically by the build; apply it manually on
# real hardware. If the kernel enumerates the adapters as ttyUSB* instead of
# ttyACM*, adjust KERNEL== accordingly.

SUBSYSTEM=="tty", KERNEL=="ttyACM*", ENV{ID_PATH}=="REPLACE_WITH_LEFT_ID_PATH", SYMLINK+="elephant_gripper_left", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ENV{ID_PATH}=="REPLACE_WITH_RIGHT_ID_PATH", SYMLINK+="elephant_gripper_right", MODE="0660", GROUP="dialout"
