prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include/x86_64-linux-gnu

Name: libavformat
Description: FFmpeg container format library
Version: 62.12.100
Requires: 
Requires.private: libavcodec >= 62.28.100, libswresample >= 6.3.100, libavutil >= 60.26.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -latomic -lxml2 -lbz2 -ldvdnav -lpthread -ldvdread -lgme -lopenmpt -lstdc++ -lchromaprint -lbluray -L/usr/lib/x86_64-linux-gnu -lgcrypt -lz -lssl -lcrypto -lrabbitmq -lrist -lsrt -lsmbclient -lzmq
Cflags: -I${includedir}
