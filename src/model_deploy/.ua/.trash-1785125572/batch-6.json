    {
      "id": "file:act/ui/observation_pipeline.py",
      "type": "file",
      "name": "observation_pipeline.py",
      "filePath": "act/ui/observation_pipeline.py",
      "summary": "观测流水线的冻结类型化组装门面（deploy_057），从单一 DeployConfig 与规范 PolicyInputSpec 装配完整 L2-02 观测链（collector + buffer + adapter），所有 RAM 校验先于任何 ROS 订阅创建，确保错误配置快速失败而非泄漏部分订阅。",
      "tags": ["facade", "observation-pipeline", "validation", "factory", "fail-fast"],
      "complexity": "moderate",
      "languageNotes": "使用 @dataclass(frozen=True) 保证流水线对象不可变；传入的 input_spec 与 monotonic_clock 保持身份相等（identity-equal），使 ControlLoop 依赖单一稳定契约。"
    },
    {
      "id": "function:act/ui/observation_pipeline.py:build_observation_pipeline",
